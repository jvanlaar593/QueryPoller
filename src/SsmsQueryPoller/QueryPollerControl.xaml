<UserControl x:Class="SsmsQueryPoller.QueryPollerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingBackgroundKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingTextKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridLineKey}}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" MinHeight="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Source query window -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Connection from:" />
            <Button x:Name="CopyQueryButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"
                    Content="Copy query from window"
                    ToolTip="Copy the selected text (or all text) of the chosen query window into the poll query."
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                    Click="OnCopyQueryClick" />
            <ComboBox x:Name="EditorCombo"
                      ToolTip="Connected query windows. The poller opens its own connection using the same server, login and options."
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                      DropDownOpened="OnEditorDropDownOpened"
                      SelectionChanged="OnEditorSelectionChanged" />
        </DockPanel>

        <!-- Poll settings -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,4" Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Server:" />
                <TextBlock x:Name="ServerText" VerticalAlignment="Center" FontWeight="SemiBold" Text="(none)" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Database:" />
                <TextBox x:Name="DatabaseBox" Width="150" VerticalContentAlignment="Center"
                         ToolTip="Database to run the query in. Leave empty for the login's default database."
                         Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Every" />
                <TextBox x:Name="IntervalBox" Width="48" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                         ToolTip="Polling interval in seconds (minimum 1). Polls never overlap."
                         Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
                <TextBlock Style="{StaticResource FieldLabel}" Margin="4,0,0,0" Text="sec" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Timeout" />
                <TextBox x:Name="TimeoutBox" Width="48" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                         ToolTip="Command timeout in seconds (0 = no timeout)."
                         Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
                <TextBlock Style="{StaticResource FieldLabel}" Margin="4,0,0,0" Text="sec" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Auto-stop after" />
                <TextBox x:Name="AutoStopBox" Width="48" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                         ToolTip="Stop polling once the results have stayed identical for this many seconds (0 = never)."
                         Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
                <TextBlock Style="{StaticResource FieldLabel}" Margin="4,0,0,0" Text="sec unchanged" />
            </StackPanel>
            <CheckBox x:Name="StopOnErrorCheck" Margin="0,2,12,2" VerticalAlignment="Center" Content="Stop on error"
                      Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                <Button x:Name="StartStopButton" MinWidth="70" Padding="8,2" Content="Start"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                        Click="OnStartStopClick" />
                <Button x:Name="RunNowButton" MinWidth="70" Margin="6,0,0,0" Padding="8,2" Content="Run now"
                        ToolTip="Run the query immediately."
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                        Click="OnRunNowClick" />
            </StackPanel>
        </WrapPanel>

        <!-- Query text -->
        <TextBox x:Name="QueryBox" Grid.Row="2"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="13"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="Transparent" />

        <!-- Results -->
        <DockPanel Grid.Row="4">
            <StackPanel x:Name="ResultSetPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Result set:" />
                <ComboBox x:Name="ResultSetCombo" MinWidth="200"
                          Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                          SelectionChanged="OnResultSetSelectionChanged" />
            </StackPanel>
            <DataGrid x:Name="ResultsGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserSortColumns="True"
                      SelectionMode="Extended" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      FontFamily="Consolas" FontSize="12"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                      Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                      RowBackground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                      BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                      HorizontalGridLinesBrush="{DynamicResource {x:Static vsshell:VsBrushes.GridLineKey}}"
                      VerticalGridLinesBrush="{DynamicResource {x:Static vsshell:VsBrushes.GridLineKey}}"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}" />
        </DockPanel>

        <!-- Status -->
        <DockPanel Grid.Row="5" Margin="0,4,0,0">
            <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="Pick a connected query window, enter a query and press Start." />
        </DockPanel>
    </Grid>
</UserControl>
